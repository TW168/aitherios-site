# Copy to .env on the server and fill in real values:
#   cp .env.example .env
# .env is ignored by git. Never commit real values.

# --- Django ---
DJANGO_DEBUG=false
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=aitherios.cloud,www.aitherios.cloud,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://aitherios.cloud,https://www.aitherios.cloud
WAGTAILADMIN_BASE_URL=https://aitherios.cloud

# --- MariaDB ---
DB_NAME=aitherios
DB_USER=aitherios
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_PORT=3306

# --- Docker ---
# Port on the VPS (localhost only) and the network shared with Caddy.
WEB_PORT=8000
PROXY_NETWORK=proxy
